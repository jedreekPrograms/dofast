# doFast local development environment
COMPOSE_PROJECT_NAME=dofast

# PostgreSQL
DB_NAME=dofast
DB_USER=dofast
DB_PASSWORD=dofast-local-password
# 5434 avoids colliding with other local PostgreSQL projects.
DB_PORT=5434

# Applications
API_PORT=8080
WEB_PORT=5173

# Authentication
# Replace with a high-entropy secret before using outside local development.
JWT_SECRET=local-only-change-this-jwt-secret-please-32-bytes-minimum
JWT_EXPIRATION_MS=3600000

# WebSocket handshake origins. Production must list only trusted HTTPS frontends,
# comma-separated (for example: https://dofast.pl,https://app.dofast.pl). A global '*'
# is rejected at startup. Local defaults allow localhost/127.0.0.1 on any port.
WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# Sign in with Google. Use the same public OAuth Web Client ID on API and web.
GOOGLE_AUTH_CLIENT_ID=
VITE_GOOGLE_AUTH_CLIENT_ID=

# Sign in with Apple. Client/redirect values are public; Team ID, Key ID and private key
# stay server-side. APPLE_AUTH_PRIVATE_KEY_BASE64 is base64 of the downloaded .p8 file.
APPLE_AUTH_CLIENT_ID=
APPLE_AUTH_REDIRECT_URI=
APPLE_AUTH_TEAM_ID=
APPLE_AUTH_KEY_ID=
APPLE_AUTH_PRIVATE_KEY_BASE64=
APPLE_AUTH_CHALLENGE_TTL_MINUTES=10
VITE_APPLE_AUTH_CLIENT_ID=
VITE_APPLE_AUTH_REDIRECT_URI=

# Optional administrator bootstrap. Leave empty for normal development.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NICKNAME=doFast Admin

# Stripe test credentials. STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are server-side secrets.
# VITE_STRIPE_PUBLISHABLE_KEY is intentionally public and is embedded into the web build.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
VITE_STRIPE_PUBLISHABLE_KEY=

# Platform settlement fee in basis points. 100 bps = 1.00%.
# The fee is snapshotted when escrow is created, so changing this value never changes existing jobs.
PLATFORM_FEE_BASIS_POINTS=100

# Worker cash-out. The sandbox provider NEVER sends real money and is only for local development/CI.
# Stripe Connect onboarding and Stripe Connect money movement have separate kill switches.
# Keeping PAYOUT_STRIPE_CONNECT_DISPATCH_ENABLED=false makes PAYOUT_PROVIDER=stripe-connect fail closed.
PAYOUT_PROVIDER=sandbox
PAYOUT_SANDBOX_ENABLED=true
PAYOUT_MINIMUM_AMOUNT=1.00
PAYOUT_MAX_ATTEMPTS=5
PAYOUT_RETRY_BASE_SECONDS=15
PAYOUT_STALE_PROCESSING_SECONDS=300
PAYOUT_DISPATCH_INTERVAL_MS=2000
PAYOUT_STRIPE_CONNECT_ENABLED=false
PAYOUT_STRIPE_CONNECT_DISPATCH_ENABLED=false
PAYOUT_STRIPE_CONNECT_COUNTRY=PL
PAYOUT_STRIPE_CONNECT_REFRESH_URL=http://localhost:5173/wallet?stripe-connect=refresh
PAYOUT_STRIPE_CONNECT_RETURN_URL=http://localhost:5173/wallet?stripe-connect=return

# Routing. Local/CI use a clearly-labelled deterministic provider without external calls.
# Set ROUTING_PROVIDER=google and provide a server-restricted Routes API key for real driving ETA.
ROUTING_PROVIDER=deterministic
ROUTING_QUOTE_TTL_MINUTES=15
GOOGLE_MAPS_ROUTES_API_KEY=

# Live courier tracking. GPS updates can arrive frequently, while paid route/traffic ETA
# is deliberately refreshed less often to control provider cost and latency.
# The implied-speed guard rejects obvious GPS teleports after accounting for reported accuracy.
# Samples must also report accuracy no worse than TRACKING_MAX_ACCURACY_METERS so a very poor
# device fix cannot move the courier marker or trigger a misleading ETA refresh.
# Server-side throttling is a security boundary: modified clients cannot persist GPS samples
# faster than this interval even if they bypass frontend throttling.
# Device capture timestamps are accepted only in a narrow freshness window to limit delayed
# replay while still allowing modest client/server clock skew.
# Checkpoint confirmation additionally requires a fresh fix within the configured arrival radius;
# reported GPS accuracy is used as uncertainty allowance instead of pretending the fix is exact.
TRACKING_ETA_REFRESH_SECONDS=30
TRACKING_ETA_REFRESH_MOVEMENT_METERS=150
TRACKING_STALE_AFTER_SECONDS=20
TRACKING_CHECKPOINT_ARRIVAL_RADIUS_METERS=100
TRACKING_MAX_IMPLIED_SPEED_METERS_PER_SECOND=80
TRACKING_MAX_ACCURACY_METERS=150
TRACKING_MIN_UPDATE_INTERVAL_MILLIS=1000
TRACKING_MAX_SAMPLE_AGE_SECONDS=120
TRACKING_FUTURE_TOLERANCE_SECONDS=30

# Encrypted job attachments. The default key below is ONLY for local development/CI.
# Production must provide a new random 32-byte AES key encoded as base64 and keep it server-side.
# Example generation: openssl rand -base64 32
ATTACHMENT_ENCRYPTION_KEY_BASE64=ZG9mYXN0LWxvY2FsLWF0dGFjaG1lbnQta2V5LTIwMjY=
ATTACHMENT_MAX_FILE_SIZE=10MB
ATTACHMENT_MAX_REQUEST_SIZE=11MB
ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
ATTACHMENT_MAX_PER_JOB=12

# Google Maps browser configuration. Restrict this key by HTTP referrer and enable only
# Maps JavaScript API, Places API (New) and Geocoding API.
# Docker passes these values to Vite at image build time.
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
