# doFast local development environment
COMPOSE_PROJECT_NAME=dofast

# PostgreSQL
DB_NAME=dofast
DB_USER=dofast
DB_PASSWORD=dofast-local-password
# 5434 avoids colliding with other local PostgreSQL projects.
DB_PORT=5434

# Applications
API_PORT=8080
WEB_PORT=5173

# Authentication
# Replace with a high-entropy secret before using outside local development.
JWT_SECRET=local-only-change-this-jwt-secret-please-32-bytes-minimum
JWT_EXPIRATION_MS=3600000

# Optional administrator bootstrap. Leave empty for normal development.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NICKNAME=doFast Admin

# Stripe test credentials
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Routing. Local/CI use a clearly-labelled deterministic provider without external calls.
# Set ROUTING_PROVIDER=google and provide a server-restricted Routes API key for real driving ETA.
ROUTING_PROVIDER=deterministic
ROUTING_QUOTE_TTL_MINUTES=15
GOOGLE_MAPS_ROUTES_API_KEY=

# Google Maps browser configuration. Restrict this key by HTTP referrer and enable only
# Maps JavaScript API, Places API (New) and Geocoding API.
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
